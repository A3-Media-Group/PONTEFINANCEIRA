RewriteEngine On

# Redireciona a URL antiga do artigo (?slug=) direto para a versão amigável
# no host canônico (vem antes da regra de host para não gerar dois saltos)
RewriteCond %{THE_REQUEST} /artigo\.php\?slug=([^\s&]+) [NC]
RewriteRule ^ https://www.pontefinanceira.com.br/artigo/%1? [R=301,L]

# Host canônico: https://www.pontefinanceira.com.br em UM único 301.
# http://sem-www, https://sem-www e http://www vão direto para https://www
# (antes eram duas regras em sequência, gerando cadeia http -> https -> www).
RewriteCond %{HTTP_HOST} ^pontefinanceira\.com\.br$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.pontefinanceira.com.br%{REQUEST_URI} [L,R=301]

# URL amigável do artigo (/artigo/slug) aponta internamente para artigo.php
RewriteRule ^artigo/([a-zA-Z0-9-]+)/?$ artigo.php?slug=$1 [L,QSA]

# Páginas de categoria, tag e autor
RewriteRule ^categoria/([a-zA-Z0-9-]+)/?$ categoria.php?slug=$1 [L,QSA]
RewriteRule ^tag/([a-zA-Z0-9-]+)/?$ tag.php?slug=$1 [L,QSA]
RewriteRule ^autor/([a-zA-Z0-9-]+)/?$ autor.php?slug=$1 [L,QSA]

# Tipos MIME corretos para downloads (servidor não tinha esses mapeados)
<IfModule mod_mime.c>
    AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
    AddType application/vnd.ms-excel .xls
    AddType application/pdf .pdf
</IfModule>

# Página de erro 404 customizada
ErrorDocument 404 /404.php

# Compressão de texto
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
